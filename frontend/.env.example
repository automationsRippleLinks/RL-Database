# api path used by the frontend
VITE_API_BASE_URL=/api/v1

# backend address used by the local development proxy
VITE_PROXY_TARGET=http://localhost:8000


# Enable frontend monitoring.
VITE_FARO_ENABLED=false

# Replace with your Grafana Faro collector URL.
VITE_FARO_COLLECTOR_URL=https://faro-collector.example.invalid/collect/app

# Enable frontend request tracing.
VITE_FARO_TRACING_ENABLED=false

# Application release version.
VITE_APP_VERSION=0.1.0

# Use development locally and production for the live app.
VITE_APP_ENVIRONMENT=development