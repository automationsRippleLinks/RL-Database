# === FastApi settings ==================================================================================================================
ENVIRONMENT="DEV"
API_VERSION="0.1.0"
API_ROOT_PATH= "/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:5173"
ALLOWED_DOMAINS="ripplelinks.com"
FRONTEND_URL= "http://localhost:5173"

# === DB settings ========================================================================================================================
DB_HOST= "localhost"
DB_PORT= 5432
DB_USERNAME= ""
DB_PASSWORD= ""
DB_NAME= "RL_DB_DEV"
DB_ECHO= False
DB_POOL_SIZE= 10
DB_MAX_OVERFLOW= 20
DB_POOL_TIMEOUT= 30
DB_POOL_RECYCLE= 1800
DB_POOL_PRE_PING= True

# === REDIS settings =====================================================================================================================
REDIS_HOST= "localhost"
REDIS_PORT= 6379
REDIS_PATH= "0"
REDIS_MAX_CONNECTIONS= 40
REDIS_CACHE_VERSION= "v1"

# === Google OAuth settings ==============================================================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTH_URL= "https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL= "https://oauth2.googleapis.com/token"

# === MAIL settings =====================================================================================================================
RL_LOGO_CDN_URL=
SMTP_HOST= "smtp.gmail.com"
SMTP_PORT= 587
SMTP_USER= "automations@ripplelinks.com"
SMTP_PASSWORD=
SMTP_FROM= "Automation RL <automations@ripplelinks.com>"

# === Apify settings ============================================================================================
APIFY_API_TOKEN=
APIFY_WEBHOOK_SECRET=
APIFY_IG_PROFILE_ACTOR= "apify/instagram-profile-scraper"
APIFY_REFRESH_AFTER_DAYS = 30
APIFY_REFRESH_BACTH = 500
APIFY_RECONCILE_AFTER_MINUTES= 10

# === AI Parser settings ============================================================================================
AI_API_KEY =
AI_MODEL = "claude-haiku-4-5"
AI_BATCH_SIZE = 25
AI_CONCURRENCY = 4
AI_TIMEOUT = 90
AI_MAX_ATTEMPTS = 2

# === Observability: Opentelemetry -> Grafana ============================================================================================
LOG_LEVEL= "INFO"
OTEL_ENABLED= true
OTEL_EXPORTER_OTLP_ENDPOINT= "http://localhost:4318"
OTEL_EXPORTER_OTLP_HEADERS=# "Authorization=Basic <base64 of instanceId:token>", from grafana cloud
OTEL_METRIC_INTERVAL_SECONDS= 60

# === Alerts: `python -m app.oversability.alerts` pushes these to Grafana ================================================================
GRAFANA_URL= "http://localhost:3000"
GRAFANA_TOKEN=
GRAFANA_PROMETHEUS_UID=
ALERT_EMAILS= "automations@ripplelinks.com"
ALERT_APIFY_OVERDUE_MINUTES= 60
ALERT_WORKER_SILENT_MINUTES= 15

# === Apps Script endpoint settings ======================================================================================================
APPS_SCRIPT_API_SECRET=
APPS_SCRIPT_API_URL=
APPS_SCRIPT_API_CALL_TIMEOUT= 300

# === Search related settings =============================================================================================================
MAX_PAGE_SIZE= 500
BRAND_DETAIL_LIMIT= 100
TOP_CREATORS_LIMIT= 10