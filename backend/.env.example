# === FastApi settings ==================================================================================================================
ENVIRONMENT="DEV"
API_VERSION="0.1.0"
API_ROOT_PATH= "/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:5173"
ALLOWED_DOMAINS="ripplelinks.com"
FRONTEND_URL= "http://localhost:5173"

# === DB settings ========================================================================================================================
DB_TYPE= "postgresql"
DB_DRIVER= "asyncpg"
DB_DRIVER_MIGRATION= "psycopg2"
DB_HOST= "localhost"
DB_PORT= 5432
DB_USERNAME= ""
DB_PASSWORD= ""
DB_NAME= "RL_DB_DEV"
DB_ECHO= False
DB_POOL_SIZE= 10
DB_MAX_OVERFLOW= 20
DB_POOL_TIMEOUT= 30
DB_POOL_RECYCLE= 1800
DB_POOL_PRE_PING= True

# === REDIS settings =====================================================================================================================
REDIS_HOST= "localhost"
REDIS_PORT= 6379
REDIS_PATH= "0"
REDIS_MAX_CONNECTIONS= 40

REDIS_CACHE_VERSION= "v1"

OAUTH_STATE_PREFIX= "oauth_state:"
OAUTH_STATE_TTL= 5 * 60

SESSION_PREFIX= "auth_session:"
SESSION_TTL= 12 * 60 * 60

USER_SESSIONS_PREFIX= "user_sessions:"

EMAIL_VERIFY_PREFIX= "email_verify:"
EMAIL_VERIFICATION_TTL= 24 * 60 * 60

PASSWORD_RESET_PREFIX= "password_reset:"
PASSWORD_RESET_TTL= 10 * 60

FACETS_PREFIX= "facets:"
FACETS_TTL= 24 * 60 * 60

SUGGEST_PREFIX= "suggest:"
SUGGEST_TTL= 5 * 60

SEARCH_PREFIX= "search:"
SEARCH_TTL= 60

RATE_LIMIT_PREFIX= "ratelimit:"

# === Google OAuth settings ==============================================================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTH_URL= "https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL= "https://oauth2.googleapis.com/token"

# === MAIL settings =====================================================================================================================
RL_LOGO_CDN_URL=
SMTP_HOST= "smtp.gmail.com"
SMTP_PORT= 587
SMTP_USER= "automations@ripplelinks.com"
SMTP_PASSWORD=
SMTP_FROM= "Automation RL <automations@ripplelinks.com>"

# === Apps Script endpoint settings ======================================================================================================
APPS_SCRIPT_API_SECRET=
APPS_SCRIPT_API_URL=
APPS_SCRIPT_API_CALL_TIMEOUT= 300

# === Ingestion pipeline settings =========================================================================================================
MAX_UPLOAD_BYTES= 25 * 1024 * 1024
MAX_STORED_ERRORS= 500
PG_MAX_PARAMS= 32767

# === Search related settings =============================================================================================================
MAX_PAGE_SIZE= 500
BRAND_DETAIL_LIMIT= 100
TOP_CREATORS_LIMIT= 10